# ----- Required -----------------------------------------------------------
# Bot token from @BotFather. Secret: never commit .env.
BOT_TOKEN=
# Public channel: @channel_username (no t.me/ prefix).
# Private channel: numeric id like -1001234567890
CHANNEL_ID=@channel_username

# ----- Polling ------------------------------------------------------------
# Seconds between MarketNewsFeed checks (5-3600)
POLL_INTERVAL=30
# true: on first start (empty database) remember current news WITHOUT posting,
# so the channel isn't flooded. false: post the current batch on first start.
INITIAL_SYNC_MODE=true
# Seconds between consecutive posts (Telegram allows ~20/min per channel)
POST_DELAY=3

# ----- Storage ------------------------------------------------------------
# Local run. Docker overrides this to sqlite:////app/data/database.db
DATABASE_URL=sqlite:///./database.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://bot:password@db:5432/marketnews

# ----- Runtime ------------------------------------------------------------
# development | production (production hides /docs)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text | json  (Docker uses json)
LOG_FORMAT=text
# Optional rotating log file for VPS runs without Docker, e.g. ./logs/bot.log
LOG_FILE=

# ----- Advanced (defaults are fine) --------------------------------------
# TELEGRAM_MAX_ATTEMPTS=4
# HTTP_TIMEOUT=10
# SHUTDOWN_TIMEOUT=15
# LOCK_FILE=./scheduler.lock
# MARKETNEWS_URL=https://marketnewsfeed.com/api/feed?limit=50

# ----- Operations (scripts/monitor.sh, scripts/backup.sh) ------------------
# Your personal Telegram user id for alerts (ask @userinfobot). Press /start on
# the alert bot once, otherwise Telegram won't let it message you.
ALERT_CHAT_ID=
# Optional separate bot for alerts. Empty = use BOT_TOKEN.
ALERT_BOT_TOKEN=
# Optional dead-man's-switch URL from healthchecks.io or Better Stack heartbeats
HEARTBEAT_URL=
# MONITOR_ERROR_THRESHOLD=5
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
