# ----- Required -----------------------------------------------------------
# Bot token from @BotFather. Secret: never commit .env.
BOT_TOKEN=
# Public channel: @channel_username (no t.me/ prefix).
# Private channel: numeric id like -1001234567890
CHANNEL_ID=@channel_username

# ----- Polling ------------------------------------------------------------
# Seconds between MarketNewsFeed checks (5-3600)
POLL_INTERVAL=10
# true: on first start (empty database) remember current news WITHOUT posting,
# so the channel isn't flooded. false: post the current batch on first start.
INITIAL_SYNC_MODE=true
# Seconds between consecutive posts (Telegram allows ~20/min per channel)
POST_DELAY=1

# ----- Content filter -------------------------------------------------------
# X accounts that are never posted (comma-separated, case-insensitive)
EXCLUDED_X_ACCOUNTS=MarketNews_Feed
# X accounts that are ALWAYS posted, instantly: no importance filter, no daily
# cap or pacing, no pause between posts (comma-separated, case-insensitive)
PRIORITY_X_ACCOUNTS=DeItaone
# These accounts usually report news ~2 minutes before others. Their items wait
# LATE_HOLD seconds so the other source's version goes out first and theirs is
# skipped as a repeat. 0 = no hold (fastest; repeats are still caught by Claude).
LATE_X_ACCOUNTS=financialjuice
LATE_HOLD=0
# Headlines mentioning any of these words are posted instantly from ANY source
# (even EXCLUDED_X_ACCOUNTS), skipping the importance filter and daily cap.
# Repeats of a recent post are still skipped. Whole words, case-insensitive.
MUST_POST_KEYWORDS=nvidia,nvda,s&p 500,s&p500,spx,nasdaq,dow jones,dow,russell 2000,apple,aapl,microsoft,msft,alphabet,google,googl,amazon,amzn,meta,tesla,tsla
# Claude scores each headline 1-5; only items >= MIN_IMPORTANCE are posted.
# true requires ANTHROPIC_API_KEY. false = post every item (still capped).
IMPORTANCE_FILTER=true
# Translate posts into Uzbek (Latin script) with Claude. Requires ANTHROPIC_API_KEY.
TRANSLATE_UZ=true
# Secret: never commit. From https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
MIN_IMPORTANCE=3
# Cost saving: score up to SCORE_BATCH_SIZE headlines per Claude call, waiting
# at most SCORE_MAX_WAIT seconds after a headline is published
SCORE_BATCH_SIZE=20
SCORE_MAX_WAIT=0
# Max posts per day, spread evenly across the day (score-5 news skips pacing)
DAILY_POST_CAP=200
# Extra posts allowed at once when a lot happens together
POST_BURST=10
# The daily cap resets at midnight in this timezone
BOT_TIMEZONE=Asia/Tashkent
# CLAUDE_TIMEOUT=30

# ----- Storage ------------------------------------------------------------
# Local run. Docker overrides this to sqlite:////app/data/database.db
DATABASE_URL=sqlite:///./database.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://bot:password@db:5432/marketnews

# ----- Runtime ------------------------------------------------------------
# development | production (production hides /docs)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text | json  (Docker uses json)
LOG_FORMAT=text
# Optional rotating log file for VPS runs without Docker, e.g. ./logs/bot.log
LOG_FILE=

# ----- Advanced (defaults are fine) --------------------------------------
# TELEGRAM_MAX_ATTEMPTS=4
# HTTP_TIMEOUT=10
# SHUTDOWN_TIMEOUT=15
# LOCK_FILE=./scheduler.lock
# MARKETNEWS_URL=https://marketnewsfeed.com/api/feed?limit=50

# ----- Operations (scripts/monitor.sh, scripts/backup.sh) ------------------
# Your personal Telegram user id for alerts (ask @userinfobot). Press /start on
# the alert bot once, otherwise Telegram won't let it message you.
ALERT_CHAT_ID=
# Optional separate bot for alerts. Empty = use BOT_TOKEN.
ALERT_BOT_TOKEN=
# Optional dead-man's-switch URL from healthchecks.io or Better Stack heartbeats
HEARTBEAT_URL=
# MONITOR_ERROR_THRESHOLD=5
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
